# Vercel deployment ignore file
# Exclude local-only and development-only directories/files

# Dev-mirror (local-only, never deploy to Vercel)
dev-mirror/
dev-mirror/**

# Supabase (migrations, tests, and functions stay in Vercel, but local Supabase CLI files are ignored)
supabase/.temp/
supabase/.branches/
.supabase/

# Local environment files (should be in .env.local or .env.*.local)
.env
.env.local
.env.*.local
.env.*.example

# Test files (pgTAP, vitest outputs)
**/*.spec.ts
**/*.test.ts
**/coverage/
**/.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts from backend (use dist/ for frontend only)
backend/dist/
backend/build/
backend/.next/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Yarn
.yarn/
.yarn/*
!.yarn/cache
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
